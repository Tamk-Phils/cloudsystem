# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AWS S3 (Netlify Compatible Names)
STORAGE_AWS_ACCESS_KEY_ID=your_access_key
STORAGE_AWS_SECRET_ACCESS_KEY=your_secret_key
STORAGE_AWS_REGION=your_region
STORAGE_AWS_BUCKET_NAME=your_bucket_name

# Backup Encryption
BACKUP_ENCRYPTION_KEY=generate_a_random_string

# Database Connection
DATABASE_URL=your_direct_postgres_url

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME="UniBackup Alerts"

# External Integration
EXTERNAL_API_KEY=your_api_key
